rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // Consultations collection (Proposal & Consultation requests)
    match /consultations/{consultationId} {
      allow create: if incoming().fullName is string && incoming().email is string && incoming().phone is string;
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'santosh@seowebfly.com');
      allow update, delete: if isSignedIn() && request.auth.token.email == 'santosh@seowebfly.com';
    }

    // AI Website Audits
    match /audits/{auditId} {
      allow create: if incoming().url is string && incoming().overallScore is number;
      allow read, list: if true;
    }

    // Saved ROI Scenarios
    match /roi_scenarios/{scenarioId} {
      allow create: if incoming().monthlyTraffic is number && incoming().calculatedRevenueLift is number;
      allow read, list: if true;
    }
  }
}
